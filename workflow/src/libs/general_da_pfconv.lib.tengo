ll := import("@platforma-sdk/workflow-tengo:ll")

getColumns := func(countsSpec, blockId, inputType) {
	field := "log2foldchange"
	degName := "log2foldchange"


	// Prepare Axis
	axes := [
			{
				column: "Contrast",
				id: "contrast",
				allowNA: false,
				spec: {
					name: "pl7.app/" + field + "/contrastGroup",
					type: "String",
					domain: {
						"pl7.app/blockId": blockId
					},
					annotations: {
						"pl7.app/label": inputType + " Contrast"
					}
				}
			},
			{
				column: countsSpec.axesSpec[1].annotations["pl7.app/label"],
				spec: countsSpec.axesSpec[1]
			}
			]

	// Prepare Columns
	columns := []
	colFC := {
				column: "log2FoldChange",
				id: "log2foldchange",
				allowNA: true,
				spec: {
					name: "pl7.app/" + field + "/" + degName,
					valueType: "Double",
					domain: {
						"pl7.app/vdj/clonotypingRunId": countsSpec.axesSpec[1].domain["pl7.app/vdj/clonotypingRunId"]
					},
					annotations: {
						"pl7.app/label": "Log2FC",
						"pl7.app/table/hValue": "true",
						// This allows us to select this Pcolumn to use it as filtering
						// in this case to keep only genes appearing in this list
						"pl7.app/isSubset": "true",
						"pl7.app/table/orderPriority": "60",
						"pl7.app/format": ".2f",
						"pl7.app/table/visibility": "default"
					}
				}
			}
	colReg := {
				column: "Regulation",
				id: "regulationDirection",
				spec: {
					name: "pl7.app/" + field + "/regulationDirection",
					valueType: "String",
					domain: {
						"pl7.app/vdj/clonotypingRunId": countsSpec.axesSpec[1].domain["pl7.app/vdj/clonotypingRunId"]
					},
					annotations: {
						"pl7.app/label": "Regulation direction (Up\\Down\\NS)",
						"pl7.app/table/orderPriority": "5",
						"pl7.app/table/visibility": "default"
					}
				}
			}

	columns = columns + [
			colFC,
			colReg
			]

	return {
		axes: axes,
		columns: columns,
		storageFormat: "Parquet",
		partitionKeyLength: 1
	}
}

export ll.toStrict({
	getColumns: getColumns
})
